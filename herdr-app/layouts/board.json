{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "preview": "layouts/board.svg",
  "children": [
    {
      "id": "tabs",
      "type": "block",
      "size": {
        "px": 42
      },
      "window_drag": true,
      "content": {
        "mod": "timer-tabs"
      }
    },
    {
      "id": "work-body",
      "type": "row",
      "padding": 8,
      "gap": 8,
      "children": [
        {
          "id": "board",
          "type": "block",
          "size": {
            "weight": 3
          },
          "min": 420,
          "content": {
            "mod": "agent-board"
          }
        },
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "gap": 8,
              "radius": 10,
              "background": "background",
              "lone": true,
              "border": {
                "width": 1,
                "color": "border"
              },
              "focus": {
                "width": 1,
                "color": "accent"
              },
              "header": {
                "content": {
                  "mod": "pane"
                },
                "height": 30,
                "position": "top",
                "reveal": "always"
              }
            }
          },
          "size": {
            "weight": 2
          },
          "min": 320
        },
        {
          "id": "panel",
          "type": "column",
          "hidden": true,
          "size": {
            "px": 368
          },
          "min": 280,
          "max": 900,
          "children": [
            {
              "id": "panel-body",
              "type": "stack",
              "active": "files",
              "children": [
                {
                  "id": "files",
                  "type": "block",
                  "content": {
                    "mod": "my-files"
                  }
                },
                {
                  "id": "changes",
                  "type": "block",
                  "content": {
                    "mod": "changes"
                  }
                },
                {
                  "id": "graph",
                  "type": "block",
                  "content": {
                    "mod": "git-graph"
                  }
                },
                {
                  "id": "github",
                  "type": "block",
                  "content": {
                    "mod": "github"
                  }
                },
                {
                  "id": "issues",
                  "type": "block",
                  "content": {
                    "mod": "issues"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "status",
      "type": "row",
      "size": {
        "px": 28
      },
      "resizable": false,
      "children": [
        {
          "id": "status-main",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          }
        },
        {
          "id": "status-ci",
          "type": "block",
          "size": {
            "px": 240
          },
          "content": {
            "mod": "github",
            "props": {
              "view": "ci"
            }
          }
        }
      ]
    }
  ]
}